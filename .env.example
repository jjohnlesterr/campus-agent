# Copy to .env.local for development. Set production values in Vercel → Project → Settings →
# Environment Variables, never in this file. Keep development and production values separate.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI and email
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public base URL for email links (production: the deployed site)
NEXT_PUBLIC_APP_URL=

# Signs the guest question-limit cookie (server-only). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value per environment. Changing it resets guests' free-question counts once.
GUEST_SESSION_SECRET=
